<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.DashboardController"
      spacing="18.0" styleClass="content-view">
    <children>
        <VBox spacing="6.0">
            <children>
                <Label fx:id="sectionTitleLabel" text="Dashboard" styleClass="section-title" />
                <Label fx:id="summaryLabel" text="0 saved contexts" styleClass="section-subtitle" />
            </children>
        </VBox>
        <StackPane VBox.vgrow="ALWAYS">
            <children>
                <ScrollPane fx:id="cardsScrollPane" fitToWidth="true" hbarPolicy="NEVER" styleClass="cards-scroll-pane">
                    <content>
                        <FlowPane fx:id="cardsPane" hgap="18.0" vgap="18.0" prefWrapLength="1120.0">
                            <padding>
                                <Insets top="6" right="6" bottom="6" left="6" />
                            </padding>
                        </FlowPane>
                    </content>
                </ScrollPane>
                <Label fx:id="emptyStateLabel" text="No contexts yet. Capture a branch, path, commands, and notes so your next restore feels instant." wrapText="true" styleClass="empty-state-label" />
            </children>
        </StackPane>
    </children>
    <padding>
        <Insets top="6" right="6" bottom="6" left="6" />
    </padding>
</VBox>
