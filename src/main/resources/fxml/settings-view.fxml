<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.SettingsController"
      spacing="18.0" styleClass="content-view">
    <children>
        <VBox spacing="6.0">
            <children>
                <Label text="Settings" styleClass="section-title" />
                <Label text="Choose your preferred tools and UI theme." styleClass="section-subtitle" />
            </children>
        </VBox>

        <VBox spacing="18.0" styleClass="form-card">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24" />
            </padding>
            <children>
                <VBox spacing="8.0">
                    <children>
                        <Label text="Preferred Code Editor" styleClass="field-label" />
                        <ComboBox fx:id="editorComboBox" maxWidth="1.7976931348623157E308" />
                    </children>
                </VBox>
                <VBox spacing="8.0">
                    <children>
                        <Label text="Default Terminal" styleClass="field-label" />
                        <ComboBox fx:id="terminalComboBox" maxWidth="1.7976931348623157E308" />
                    </children>
                </VBox>
                <VBox spacing="8.0">
                    <children>
                        <Label text="Theme" styleClass="field-label" />
                        <ComboBox fx:id="themeComboBox" maxWidth="1.7976931348623157E308" />
                    </children>
                </VBox>
                <Button fx:id="saveSettingsButton" text="Save Settings" onAction="#onSaveSettings" styleClass="primary-button, glass-button" />
            </children>
        </VBox>
    </children>
    <padding>
        <Insets top="6" right="6" bottom="6" left="6" />
    </padding>
</VBox>
