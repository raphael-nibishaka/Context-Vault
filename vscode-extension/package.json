{
  "name": "context-vault",
  "displayName": "Context Vault",
  "description": "Detect open tabs, terminals, and Git branch — then save and restore developer contexts from inside VS Code.",
  "version": "1.1.0",
  "publisher": "contextvault",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/raphael-nibishaka/Context-Vault.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "context",
    "tabs",
    "cursor",
    "restore",
    "session",
    "workspace",
    "git",
    "terminals"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "context-vault",
          "title": "Context Vault",
          "icon": "media/context-vault.svg"
        }
      ]
    },
    "views": {
      "context-vault": [
        {
          "type": "webview",
          "id": "contextVault.sidebar",
          "name": "Context Vault"
        }
      ]
    },
    "commands": [
      {
        "command": "contextVault.saveContext",
        "title": "Context Vault: Save Context",
        "icon": "$(save)"
      },
      {
        "command": "contextVault.restoreContext",
        "title": "Context Vault: Restore Context",
        "icon": "$(history)"
      },
      {
        "command": "contextVault.showContexts",
        "title": "Context Vault: Show My Contexts",
        "icon": "$(list-unordered)"
      },
      {
        "command": "contextVault.saveEditorSession",
        "title": "Context Vault: Save Editor Session"
      },
      {
        "command": "contextVault.restoreEditorSession",
        "title": "Context Vault: Restore Editor Session"
      },
      {
        "command": "contextVault.clearEditorSession",
        "title": "Context Vault: Clear Saved Session"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "contextVault.saveContext",
          "when": "view == contextVault.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "contextVault.restoreContext",
          "when": "view == contextVault.sidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Context Vault",
      "properties": {
        "contextVault.autoSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically save open tabs and cursor positions while you work."
        },
        "contextVault.autoRestore": {
          "type": "boolean",
          "default": true,
          "description": "Automatically restore the last editor session when a project is opened."
        },
        "contextVault.saveDelayMs": {
          "type": "number",
          "default": 750,
          "minimum": 100,
          "description": "Debounce delay (ms) before auto-saving editor session changes."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.5"
  }
}
